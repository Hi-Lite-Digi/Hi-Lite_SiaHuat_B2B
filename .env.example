# Server-only AI credentials. Never prefix these with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Full-catalogue photo lookup; set false to return to the existing vision flow.
CATALOGUE_IMAGE_LOOKUP_ENABLED=true
# Local indexing worker only. Never deploy or expose this admin credential.
CATALOGUE_IMAGE_ADMIN_KEY=

# Local catalogue administration only; do not set these in the web deployment.
SIA_HUAT_PROJECT_REF=
SIA_HUAT_POSTGRES_PASSWORD=
